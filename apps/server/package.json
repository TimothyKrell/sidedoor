{
  "name": "@sidedoor/server",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "sidedoor": "./dist/bin.mjs"
  },
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=../../packages/shared/src --import tsx src/bin.ts serve --dev",
    "build": "tsdown && node scripts/copy-client.mjs",
    "start": "node dist/bin.mjs serve",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "0.0.83",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.0.6",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.64.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@sidedoor/shared": "workspace:*",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./*": "./src/*.ts"
  }
}

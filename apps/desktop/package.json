{
  "name": "@sidedoor/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Sidedoor: your job search, run by your AI",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "tsdown",

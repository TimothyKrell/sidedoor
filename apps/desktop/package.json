    "electron": "44.9.3",
    "electron-builder": "26.16.1",
    "tsdown": "^0.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@sidedoor/shared": "workspace:*"
  }
}
